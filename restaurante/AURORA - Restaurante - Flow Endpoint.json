      "id": "n019-0000-4000-8000-000000000000",
      "name": "Resp Default",
      "notes": ""
    },
    {
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\n\nconst responsePayload = $input.first().json.response_to_send;\n\nconst aesKeyBuffer = Buffer.from($('Decryption').first().json.aesKeyBuffer.data);\nconst ivBuffer = Buffer.from($('Decryption').first().json.ivBuffer.data);\nconst flippedIV = Buffer.from(ivBuffer.map((b) => ~b));\n\nconst cipher = crypto.createCipheriv(\"aes-128-gcm\", aesKeyBuffer, flippedIV);\nconst encryptedResponse = Buffer.concat([\n  cipher.update(JSON.stringify(responsePayload), \"utf-8\"),\n  cipher.final(),\n  cipher.getAuthTag(),\n]);\n\nreturn [{ json: { response: encryptedResponse.toString(\"base64\") } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "n020-0000-4000-8000-000000000000",
      "name": "Encryption",
      "notes": "Recriptografa (IV invertido)."
    },
