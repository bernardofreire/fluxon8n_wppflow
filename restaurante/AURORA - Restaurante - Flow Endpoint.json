    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json);\nconst products = (items.length === 1 && Array.isArray(items[0])) ? items[0] : items;\nconst brl = (v) => 'R$ ' + Number(v || 0).toFixed(2).replace('.', ',');\nconst MAX_CATS = 12, MAX_PER_CAT = 20;\nconst groups = {}; const order = [];\nproducts.forEach((p) => { const cat = (p.categ_id && p.categ_id.name) || 'Outros'; if (!groups[cat]) { groups[cat] = []; order.push(cat); } groups[cat].push(p); });\nconst warnings = [];\nif (order.length > MAX_CATS) warnings.push('Categorias: ' + order.length + ' no total, cortou ' + (order.length - MAX_CATS));\nconst data = {};\norder.slice(0, MAX_CATS).forEach((cat, i) => {\n  const n = i + 1; const list = groups[cat];\n  if (list.length > MAX_PER_CAT) warnings.push('Categoria \"' + cat + '\": ' + list.length + ' itens, cortou ' + (list.length - MAX_PER_CAT));\n  data['cat_' + n + '_name'] = String(cat).slice(0, 30);\n  data['cat_' + n + '_visible'] = true;\n  data['cat_' + n + '_items'] = list.slice(0, MAX_PER_CAT).map((p) => ({ id: String(p.id), title: String(p.name || '').slice(0, 30), description: brl(p.list_price) }));\n});\nfor (let n = 1; n <= MAX_CATS; n++) { if (!data['cat_' + n + '_visible']) { data['cat_' + n + '_name'] = ''; data['cat_' + n + '_visible'] = false; data['cat_' + n + '_items'] = [{ id: '_', title: '-' }]; } }\ndata.has_notice = warnings.length > 0;\ndata.notice = warnings.length ? ('Aviso (corte): ' + warnings.join(' | ')) : '';\nif (warnings.length) console.log('[FLOW PRODUCTS overflow]', warnings.join(' | '));\nreturn [{ json: { response_to_send: { screen: 'PRODUCTS', data }, _warnings: warnings } }];"
      },
