    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json);\nconst products = (items.length === 1 && Array.isArray(items[0])) ? items[0] : items;\nconst byId = {};\nproducts.forEach((p) => { byId[String(p.id)] = p; });\nconst d = ($('Decryption').first().json.decryptedBody.data) || {};\nconst MAX_CATS = 12, MAX_SLOTS = 20;\nlet selected = [];\nfor (let c = 1; c <= MAX_CATS; c++) { const arr = d['selected_' + c]; if (Array.isArray(arr)) selected = selected.concat(arr); }\nselected = selected.filter((x) => x && x !== '_');\nconst warnings = [];\nif (selected.length > MAX_SLOTS) warnings.push('Itens selecionados: ' + selected.length + ', cortou ' + (selected.length - MAX_SLOTS));\nconst out = {};\nselected.slice(0, MAX_SLOTS).forEach((pid, i) => {\n  const n = i + 1; const p = byId[String(pid)] || {};\n  out['slot_' + n + '_id'] = String(pid);\n  out['slot_' + n + '_title'] = String(p.name || ('Produto ' + pid)).slice(0, 20);\n  out['slot_' + n + '_visible'] = true;\n});\nfor (let n = 1; n <= MAX_SLOTS; n++) { if (!out['slot_' + n + '_visible']) { out['slot_' + n + '_id'] = ''; out['slot_' + n + '_title'] = ''; out['slot_' + n + '_visible'] = false; } }\nout.has_notice = warnings.length > 0;\nout.notice = warnings.length ? ('Aviso (corte): ' + warnings.join(' | ')) : '';\nif (warnings.length) console.log('[FLOW QUANTITIES overflow]', warnings.join(' | '));\nreturn [{ json: { response_to_send: { screen: 'QUANTITIES', data: out }, _warnings: warnings } }];"
      },
