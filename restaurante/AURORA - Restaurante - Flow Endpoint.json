    {
      "parameters": {
        "jsCode": "const quote = $input.first().json;\nconst prep = $('Prep Quote').first().json;\nconst data = ($('Decryption').first().json.decryptedBody.data) || {};\nconst brl = (v) => 'R$ ' + Number(v || 0).toFixed(2).replace('.', ',');\nconst NL = String.fromCharCode(10);\nconst items_text = (quote.lines || []).map((l) => { const name = (l.product_id && l.product_id.name) || 'item'; return l.quantity + 'x ' + name + ' - ' + brl(l.unit_price) + ' = ' + brl(l.subtotal_taxed); }).join(NL);\nconst FRETE = 0;\nconst subtotal = Number(quote.amount_total || 0);\nconst subtotal_text = 'Subtotal: ' + brl(subtotal);\nconst delivery_fee_text = 'Frete: ' + brl(FRETE);\nconst total_text = 'Total: ' + brl(subtotal + FRETE);\nconst delivery_text = 'Entrega: ' + [data.customer_name, [data.street, data.number].filter(Boolean).join(', '), data.neighborhood].filter(Boolean).join(' - ');\nreturn [{ json: { response_to_send: { screen: 'SUMMARY', data: { items_text: items_text || '(itens)', subtotal_text, delivery_fee_text, total_text, delivery_text, order_payload: JSON.stringify(prep.orderPayload) } } } }];"
      },
