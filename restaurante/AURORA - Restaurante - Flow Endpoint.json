    {
      "parameters": {
        "jsCode": "const d = $('Decryption').first().json;\nlet response_to_send;\nif (d.action === 'BACK') { response_to_send = { screen: d.screen || 'PRODUCTS', data: {} }; }\nelse { response_to_send = { data: { acknowledged: true } }; }\nreturn [{ json: { response_to_send } }];"
      },
      "type": "n8n-nodes-base.code",
