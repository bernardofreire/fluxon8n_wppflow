        "jsCode": "const order = $input.first().json;\nconst brl = (v) => 'R$ ' + Number(v || 0).toFixed(2).replace('.', ',');\nreturn [{ json: { response_to_send: { screen: 'SUCCESS', data: { confirmation: 'Pedido ' + (order.name || order.id) + ' criado! Total ' + brl(order.amount_total) } } } }];"
