    {
      "parameters": {
        "jsCode": "const crypto = require(\"crypto\");\n\nconst PRIVATE_KEY = String($('Config Local').first().json.FLOW_PRIVATE_KEY)\n  .replace(/\\\\n/g, \"\\n\")\n  .trim();\nif (!PRIVATE_KEY || PRIVATE_KEY.includes(\"COLE_AQUI\")) {\n  throw new Error('Cole a chave privada RSA (PEM) no no \"Config Local\"');\n}\n\nconst wh = $('Flow Endpoint Webhook').first().json;\nconst body = wh.body || wh;\nconst { encrypted_aes_key, encrypted_flow_data, initial_vector } = body;\nif (!encrypted_aes_key || !encrypted_flow_data || !initial_vector) {\n  throw new Error(\"Request nao e um WhatsApp Flow (campos encrypted_* ausentes)\");\n}\n\nconst aesKeyBuffer = crypto.privateDecrypt(\n  { key: crypto.createPrivateKey(PRIVATE_KEY), padding: crypto.constants.RSA_PKCS1_OAEP_PADDING, oaepHash: \"sha256\" },\n  Buffer.from(encrypted_aes_key, \"base64\"),\n);\n\nconst flowDataBuffer = Buffer.from(encrypted_flow_data, \"base64\");\nconst ivBuffer = Buffer.from(initial_vector, \"base64\");\nconst TAG_LENGTH = 16;\nconst encryptedBody = flowDataBuffer.subarray(0, -TAG_LENGTH);\nconst authTag = flowDataBuffer.subarray(-TAG_LENGTH);\n\nconst decipher = crypto.createDecipheriv(\"aes-128-gcm\", aesKeyBuffer, ivBuffer);\ndecipher.setAuthTag(authTag);\nconst decryptedBody = JSON.parse(\n  Buffer.concat([decipher.update(encryptedBody), decipher.final()]).toString(\"utf-8\"),\n);\n\nconst route = decryptedBody.action === 'data_exchange' ? (decryptedBody.screen || '') : decryptedBody.action;\n\nreturn [{ json: { decryptedBody, aesKeyBuffer, ivBuffer, action: decryptedBody.action, screen: decryptedBody.screen || null, route } }];"
      },
