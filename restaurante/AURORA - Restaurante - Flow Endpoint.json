      "notes": ""
    },
    {
      "parameters": {
        "jsCode": "const data = ($('Decryption').first().json.decryptedBody.data) || {};\nconst cart = JSON.parse(data.cart || '[]');\nconst POS = Number($('Config Local').first().json.ODOO_POS_CONFIG_ID);\nconst quoteBody = { pos_config_id: POS, lines: cart.map((c) => ({ product_id: c.product_id, quantity: c.quantity })) };\nconst orderPayload = {\n  pos_config_id: POS,\n  order_type: 'delivery',\n  customer: { name: data.customer_name, phone: data.phone },\n  delivery_address: {\n    new: { street: (data.street || '') + (data.number ? ', ' + data.number : ''), street2: data.complement || null, city: data.neighborhood || null },\n    add_new_address: true,\n  },\n  lines: cart.map((c) => ({ product_id: c.product_id, quantity: c.quantity })),\n  source: 'whatsapp_flow',\n};\nreturn [{ json: { quoteBody, orderPayload } }];"
      },
