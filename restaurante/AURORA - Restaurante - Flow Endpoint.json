      "id": "n011-0000-4000-8000-000000000000",
      "name": "Monta QUANTITIES",
      "notes": "junta selecionados + detecta corte"
    },
    {
      "parameters": {
        "jsCode": "const data = ($('Decryption').first().json.decryptedBody.data) || {};\nconst MAX_SLOTS = 20;\nconst cart = [];\nfor (let n = 1; n <= MAX_SLOTS; n++) {\n  const id = data['id' + n]; const q = parseInt(data['q' + n], 10);\n  if (id && q > 0) cart.push({ product_id: Number(id), quantity: q });\n}\nreturn [{ json: { response_to_send: { screen: 'DELIVERY', data: { cart: JSON.stringify(cart) } } } }];"
      },
