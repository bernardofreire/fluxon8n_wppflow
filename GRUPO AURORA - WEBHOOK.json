      "id": "36e84d58-6fcf-4f36-b8eb-b07a82aa3379",
      "name": "ACK 200 OK",
      "notes": "CRITICO: responde 200 IMEDIATAMENTE para o Meta nao retentar. Roda antes de qualquer processamento."
    },
    {
      "parameters": {
        "jsCode": "// Filter robusto: descarta statuses, system events e payloads sem message real.\n// Meta manda 3 tipos no mesmo webhook:\n//  - messages: mensagem real do cliente (queremos processar)\n//  - statuses: delivered/read/failed das NOSSAS mensagens (descartar)\n//  - system: notificacoes Meta (descartar)\n\nconst body = $input.first().json.body || {};\nconst entry = body.entry?.[0];\nconst change = entry?.changes?.[0];\nconst value = change?.value || {};\n\n// Se nao tem array messages com pelo menos 1 item, descarta\nconst messages = value.messages;\nif (!Array.isArray(messages) || messages.length === 0) {\n  return [];\n}\n\nconst msg = messages[0];\n\n// Mensagem precisa ter id (wamid) e from\nif (!msg.id || !msg.from) {\n  return [];\n}\n\n// waba_id (entry[0].id) -> identifica a WABA dentro da BM (Filtro 1)\nconst wabaId = entry?.id;\nif (!wabaId) {\n  return [];\n}\n\n// metadata.phone_number_id -> identifica a unidade/numero (Filtro 2)\nconst phoneNumberId = value.metadata?.phone_number_id;\nif (!phoneNumberId) {\n  return [];\n}\n\nreturn [{\n  json: {\n    message_id: msg.id,\n    waba_id: wabaId,\n    phone_number_id: phoneNumberId,\n    body: body,\n    message: msg,\n    contact: value.contacts?.[0] || {},\n    metadata: value.metadata\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        368,
        144
      ],
